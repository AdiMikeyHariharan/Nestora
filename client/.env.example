# Frontend environment (Vite). Copy to .env.local for local dev.
#
# Leave VITE_API_URL EMPTY when using the Vercel /api rewrite (recommended) or
# when the backend co-serves the app. The client then calls the relative /api.
#
# Set it to your backend's absolute origin ONLY if you want cross-origin calls
# instead of the rewrite (requires the backend to allow this origin via CORS):
# VITE_API_URL=https://api.nestora.properties
VITE_API_URL=
